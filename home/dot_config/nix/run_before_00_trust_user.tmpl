{{ if and (eq .chezmoi.os "linux") (ne .chezmoi.username "root") -}}
#!/usr/bin/env -S nix shell --impure nixpkgs#python3 --command python3

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

CONFIG = Path("/etc/nix/nix.conf")
RESTART_COMMAND = ["systemctl", "restart", "nix-daemon.service"]


def current_user_is_trusted(timeout=10):
    result = subprocess.run(
        [
            "nix",
            "--extra-experimental-features",
            "nix-command",
            "store",
            "info",
            "--store",
            "daemon",
            "--json",
        ],
        capture_output=True,
        text=True,
        check=True,
        timeout=timeout,
    )
    info = json.loads(result.stdout)
    trusted = info.get("trusted") if isinstance(info, dict) else None
    if not isinstance(trusted, (bool, int)) or trusted not in (0, 1):
        raise TypeError("Nix did not report the current user's trust status")
    return bool(trusted)


def wait_for_trust():
    deadline = time.monotonic() + 30
    detail = "Nix still reports the current user as untrusted"
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise SystemExit(f"Timed out confirming Nix trust: {detail}")

        try:
            if current_user_is_trusted(timeout=min(2, remaining)):
                return
            detail = "Nix still reports the current user as untrusted"
        except (OSError, subprocess.SubprocessError, ValueError, TypeError) as error:
            detail = str(error)

        time.sleep(min(0.2, max(0, deadline - time.monotonic())))


def select_config(config):
    custom = config.with_name("nix.custom.conf")
    if not custom.is_file():
        return config.resolve()

    use_custom = False
    for line in config.read_text(encoding="utf-8").splitlines():
        line = line.partition("#")[0].strip()
        words = line.split()
        if (
            len(words) == 2
            and words[0] in ("include", "!include")
            and config.parent / words[1] == custom
        ):
            use_custom = True

        key, separator, _ = line.partition("=")
        if separator and key.strip() == "trusted-users":
            use_custom = False

    return (custom if use_custom else config).resolve()


def add_trusted_user(content, user):
    lines = content.splitlines()
    last = None
    for index, line in enumerate(lines):
        key, separator, _ = line.partition("#")[0].partition("=")
        if separator and key.strip() in ("trusted-users", "extra-trusted-users"):
            last = index

    if last is None:
        lines.append(f"extra-trusted-users = {user}")
    else:
        value, marker, comment = lines[last].partition("#")
        if user in value.partition("=")[2].split():
            return content
        lines[last] = f"{value.rstrip()} {user}"
        if marker:
            lines[last] += f" #{comment}"

    return "\n".join(lines) + "\n"


def update_config(config, content):
    metadata = config.stat()
    with tempfile.TemporaryDirectory(
        prefix=".chezmoi-trust.", dir=config.parent
    ) as directory:
        original = Path(directory) / "original"
        updated = Path(directory) / "updated"
        for copy in (original, updated):
            shutil.copyfile(config, copy)
            os.chown(copy, metadata.st_uid, metadata.st_gid)
            shutil.copystat(config, copy)

        updated.write_text(content, encoding="utf-8")
        updated.replace(config)
        try:
            subprocess.run(RESTART_COMMAND, check=True)
        except (OSError, subprocess.CalledProcessError) as error:
            original.replace(config)
            try:
                subprocess.run(RESTART_COMMAND, check=False)
            except OSError:
                pass
            raise SystemExit(
                f"Nix daemon restart failed ({error}); restored {config}."
            ) from error


if __name__ == "__main__":
    user = {{ .chezmoi.username | toJson }}

    try:
        if not Path("/run/systemd/system").is_dir():
            print(
                "Skipping trusted-user setup: systemd is not running.", file=sys.stderr
            )
            raise SystemExit(0)

        if os.geteuid() != 0:
            try:
                if current_user_is_trusted():
                    raise SystemExit(0)
            except (
                OSError,
                subprocess.SubprocessError,
                ValueError,
                TypeError,
            ) as error:
                print(f"Skipping trusted-user setup: {error}", file=sys.stderr)
                raise SystemExit(0) from None

            sudo = shutil.which("sudo")
            if sudo is None:
                raise SystemExit(0)
            result = subprocess.run(
                [sudo, "-n", "true"], stderr=subprocess.DEVNULL, check=False
            )
            if result.returncode:
                raise SystemExit(0)

            setup = subprocess.run(
                [sudo, "-n", sys.executable, str(Path(__file__).resolve())], check=False
            )
            if setup.returncode:
                raise SystemExit(setup.returncode)
            wait_for_trust()
            raise SystemExit(0)

        if not CONFIG.is_file():
            raise SystemExit(0)
        config = select_config(CONFIG)
        if Path("/nix/store") in config.parents:
            print(
                f"Skipping trusted-user setup: {config} is managed declaratively.",
                file=sys.stderr,
            )
            raise SystemExit(0)

        original = config.read_text(encoding="utf-8")
        updated = add_trusted_user(original, user)
        if updated == original:
            # The daemon reported this user as untrusted; load the existing settings.
            subprocess.run(RESTART_COMMAND, check=True)
        else:
            update_config(config, updated)
    except (OSError, subprocess.CalledProcessError) as error:
        raise SystemExit(f"Nix trusted-user setup failed: {error}") from error
{{- end }}
